      },
      {
        "id": 170,
        "insight": "The users would like to be able to interact with the tool via voice input, in order to work more efficiently.",
        "mentions": 19,
        "delta": 0,
        "created": "2025-11-05",
        "segment": "Mixed; Big Law Firm; Government Institutions; Publisher"
      },
      {
        "id": 116,
        "insight": "The user needs guidance in case of occuring errors in order to be able to understand what is going wrong.",
        "mentions": 15,
        "delta": 0,
        "created": "2025-10-15",
        "segment": "Mixed; Big Law Firm; Corporate Law Department"
      },
      {
        "id": 141,
        "insight": "The users struggle and wish for help when interacting with the canvas.",
        "mentions": 15,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed; Corporate Law Department"
      },
      {
        "id": 157,
        "insight": "The user wants to be able to only get a high-level overview of the thinking process and only dig deeper on demand.",
        "mentions": 15,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed; Corporate Law Department; Big Law Firm"
      },
      {
        "id": 83,
        "insight": "The user needs to be able to generate customized workflows in order to handle complex tasks.",
        "mentions": 13,
        "delta": 0,
        "created": "2025-10-14",
        "segment": "Big Law Firm; Corporate Law Department; Government Institutions"
      },
      {
        "id": 97,
        "insight": "The user needs the AI to support him to be quicker with their task.",
        "mentions": 12,
        "delta": 0,
        "created": "2025-10-15",
        "segment": "Mixed"
      },
      {
        "id": 136,
        "insight": "Users want to be able to ask questions to specific sections & prompt changes based on specific sections.",
        "mentions": 12,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed"
      },
      {
        "id": 232,
        "insight": "The user needs the tool to comply with data security measures necessary for the data that they work with and to comply with their \"Berufsrecht\".",
        "mentions": 12,
        "delta": 0,
        "created": "2025-11-30",
        "segment": "Big Law Firm; Prosecution/ Judges"
      },
      {
        "id": 156,
        "insight": "The user expects the Editor interface to be intuitive, with a layout and button design familiar from other tools.",
        "mentions": 10,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed"
      },
      {
        "id": 105,
        "insight": "The user needs to be able to get a summary in order to get a quick overview.",
        "mentions": 9,
        "delta": 0,
        "created": "2025-10-15",
        "segment": "Mixed; Prosecution/ Judges; Corporate Law Department"
      },
      {
        "id": 252,
        "insight": "The user needs the AI to seamlessly integrate into word by inserting and prompting directly in the word environment without additional manual effort on their end.",
        "mentions": 9,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed; Corporate Law Department"
      },
      {
        "id": 378,
        "insight": "The user needs to be able to organize their (prompt) templates e.g. into folders to improve organization and finding specific templates more easily.",
        "mentions": 9,
        "delta": 0,
        "created": "2026-03-04",
        "segment": "Mixed; Distribution Department"
      },
      {
        "id": 389,
        "insight": "The users need a structured way to review multiple documents.",
        "mentions": 8,
        "delta": 1,
        "created": "2026-03-31",
        "segment": "Big Law Firm; Mixed; Corporate Law Department"
      },
      {
        "id": 93,
        "insight": "The user needs the tool to be accessible and usable within their familiar working environment, especially if they have less technical proficiency.",
        "mentions": 8,
        "delta": 0,
        "created": "2025-10-15",
        "segment": "Corporate Law Department; Big Law Firm"
      },
      {
        "id": 143,
        "insight": "The users would like to be able to store prompts and share with other users for usage.",
        "mentions": 8,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed; Big Law Firm; Distribution Department"
      },
      {
        "id": 255,
        "insight": "The user expects the tool to directly use the words tracked changes feature, so that they themselves keep the overview of the changes and can send it to other parties.",
        "mentions": 8,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 253,
        "insight": "The user wants to be able to see the sources of the generated content directly in word in order to have full transparency.",
        "mentions": 7,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 254,
        "insight": "The users want to be able to mark sections within a word document and prompt referring only the selected content.",
        "mentions": 7,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 482,
        "insight": "The visible thinking process / step-by-step reasoning is highly valued — it helps users verify results and spot imprecise prompts.",
        "mentions": 7,
        "delta": 0,
        "created": "2026-07-22",
        "segment": "Unknown"
      },
      {
        "id": 81,
        "insight": "The user needs transparency about data security measures to be sure that their data is being treated confidentially and is not distributed, but only locally on their machine.",
        "mentions": 6,
        "delta": 0,
        "created": "2025-10-14",
        "segment": "Big Law Firm; Small Law Firm"
      },
      {
        "id": 110,
        "insight": "The user needs to get feedback regarding the completion of the file upload.",
        "mentions": 6,
        "delta": 0,
        "created": "2025-10-15",
        "segment": "Mixed"
      },
      {
        "id": 189,
        "insight": "The tool produces very good results with contract drafts, particularly in the IT sector (e.g. hardware maintenance contracts including SLA and schedules of services).",
        "mentions": 6,
        "delta": 0,
        "created": "2025-11-07",
        "segment": "Big Law Firm"
      },
      {
        "id": 221,
        "insight": "The user needs legislations of different countries to be used for cases that involve international parties.",
        "mentions": 6,
        "delta": 0,
        "created": "2025-11-19",
        "segment": "Corporate Law Department; Big Law Firm"
      },
      {
        "id": 321,
        "insight": "The user wants to be able to manually select documents from the knowledge base for a prompt.",
        "mentions": 6,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 483,
        "insight": "Source and citation quality is a highlight — precise references, working Fundstellen links, and access to commentary/journal literature.",
        "mentions": 6,
        "delta": 0,
        "created": "2026-07-22",
        "segment": "Unknown"
      },
      {
        "id": 126,
        "insight": "The user needs Matrix Analysis to evaluate large amounts of data simultaneously with speed and efficiency.",
        "mentions": 5,
        "delta": 0,
        "created": "2025-10-20",
        "segment": "Mixed"
      },
      {
        "id": 228,
        "insight": "The users need more onboarding on how to prompt best.",
        "mentions": 5,
        "delta": 0,
        "created": "2025-11-20",
        "segment": "Corporate Law Department; Big Law Firm"
      },
      {
        "id": 262,
        "insight": "The user needs to be able to preview changes before they are applied in the document in order to feel in control and be able to individually review them.",
        "mentions": 5,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 271,
        "insight": "The user expects a clear distinction between thinking process and content output in order to navigate the result.",
        "mentions": 5,
        "delta": 0,
        "created": "2026-01-02",
        "segment": "Big Law Firm; Corporate Law Department; Publisher"
      },
      {
        "id": 280,
        "insight": "The user would like to be able to assign specific documents to a workflow/ step within a workflow.",
        "mentions": 5,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 334,
        "insight": "The user wants to be able to retrace from which document a information orginiated from.",
        "mentions": 5,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 408,
        "insight": "User should be able to collapse the Thinking Process with one click after it is generated.",
        "mentions": 5,
        "delta": 0,
        "created": "2026-04-30",
        "segment": "Publisher"
      },
      {
        "id": 472,
        "insight": "Login is not persisted — users are auto-logged-out after a short time and a fresh login is required for every Word document.",
        "mentions": 5,
        "delta": 0,
        "created": "2026-07-22",
        "segment": "Unknown"
      },
      {
        "id": 115,
        "insight": "The user needs to be able to continue the chat even after longer times of inactivity.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-10-15",
        "segment": "Mixed"
      },
      {
        "id": 119,
        "insight": "The user needs to be able to see which chat was about which topic in order to easily navigate to the right chat.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-10-16",
        "segment": "Corporate Law Department; Mixed; Big Law Firm"
      },
      {
        "id": 142,
        "insight": "User highlight that, familiar document editing and review features (like e.g. tracked changes) are important for adoption of the Editor.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed"
      },
      {
        "id": 158,
        "insight": "The users would like to be able to revert changes that they or the tool made.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed; Corporate Law Department"
      },
      {
        "id": 163,
        "insight": "The users have trouble differentiating the upload function in the Canvas from the one in the chat.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-11-04",
        "segment": "Mixed"
      },
      {
        "id": 216,
        "insight": "The user wants to be able to use Powerpoint as an Input Document in order to be able to use all their usually used documents as input.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-11-18",
        "segment": "Corporate Law Department; Big Law Firm"
      },
      {
        "id": 259,
        "insight": "The user expects each change suggestion to come with a reasoning, why it should be changed in this way, in order to make an informed decision on the change.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 265,
        "insight": "The user needs the tool to be able to offer automatic insertion or preview of changes for manual approval in order to be able to work efficiently in all cases.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 269,
        "insight": "The user needs to be able disable tracking changes so that they can quickly iterate from scratch until they have a solid state from which they then want to track the essentiell changes being made.",
        "mentions": 4,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 277,
        "insight": "The user needs a possibility to connect the individual steps of a workflow with each other or with decision points.",
        "mentions": 4,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 294,
        "insight": "The user would like to only provide the input for the workflow and then to have it run autonomously.",
        "mentions": 4,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 467,
        "insight": "The user expects the Matrix Analysis layout to be well-structured and easy to navigate.",
        "mentions": 4,
        "delta": 0,
        "created": "2026-07-09",
        "segment": "Mixed"
      },
      {
        "id": 470,
        "insight": "The user finds that answer quality increases significantly with follow-up prompting.",
        "mentions": 4,
        "delta": 0,
        "created": "2026-07-09",
        "segment": "Big Law Firm"
      },
      {
        "id": 484,
        "insight": "Users value the fast, useful first assessment and the resulting time savings.",
        "mentions": 4,
        "delta": 0,
        "created": "2026-07-22",
        "segment": "Unknown"
      },
      {
        "id": 490,
        "insight": "The user needs the tool to preserve and fill a user-provided outline (Gliederung) instead of deleting it, and to respect legal heading-level structure.",
        "mentions": 4,
        "delta": 0,
        "created": "2026-07-23",
        "segment": "Unknown"
      },
      {
        "id": 55,
        "insight": "The user needs to be able to use the tool to draft text snippets so that they can save time.",
        "mentions": 3,
        "delta": 0,
        "created": "2025-10-09",
        "segment": "Big Law Firm; Small Law Firm; Government Institutions"
      },
      {
        "id": 94,
        "insight": "The user needs to be able to stick with their custom formatting and fonts, in order not having to reformat their document.",
        "mentions": 3,
        "delta": 0,
        "created": "2025-10-15",
        "segment": "Corporate Law Department; Big Law Firm"
      },
      {
        "id": 245,
        "insight": "The user expects matrix functions to be self-explanatory and displays to be well-structured.",
        "mentions": 3,
        "delta": 0,
        "created": "2025-11-30",
        "segment": "Corporate Law Department; Mixed"
      },
      {
        "id": 251,
        "insight": "The users want to be able to have the reasoning directly at the changed clause in order to have full transparency for themselves and others.",
        "mentions": 3,
        "delta": 0,
        "created": "2025-12-15",
        "segment": "Mixed"
      },
      {
        "id": 263,
        "insight": "The users wish to be able to have transparency of why changes have been made even after inserting them into the document in order to allow themselves or another party to have full transparency into reasoning.",
        "mentions": 3,
        "delta": 0,
        "created": "2025-12-17",
        "segment": "Mixed"
      },
      {
        "id": 278,
        "insight": "The user wants a tool case that already involves example e.g. prompts / steps which they can reuse or adjust to their needs.",
        "mentions": 3,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 295,
        "insight": "The user needs to be able to retrace the results of every step of the workflow, in order to double check results.",
        "mentions": 3,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 303,
        "insight": "The user wants other users to only be able to use the workflow not edit it, so that their workflow is not ruined.",
        "mentions": 3,
        "delta": 0,
        "created": "2026-01-28",
        "segment": "Mixed"
      },
      {
        "id": 372,
        "insight": "The user needs the chat export to have sources inserted in order to use it for documentation and sharing purposes.",
        "mentions": 3,
        "delta": 0,
        "created": "2026-02-23",
        "segment": "Big Law Firm; Corporate Law Department"
      },
      {
        "id": 392,
        "insight": "Users need to be able to add supporting documents to the Word-Add-In in order to adjust the document based on further info.",
        "mentions": 3,
        "delta": 0,
        "created": "2026-04-17",
        "segment": "Corporate Law Department"
      },
      {
        "id": 475,
        "insight": "Recurring system errors / crashes — 'Es ist ein interner Fehler aufgetreten' appears repeatedly, especially when reviewing documents in the Editor.",
        "mentions": 3,
        "delta": 0,
        "created": "2026-07-22",
        "segment": "Unknown"
      },
      {
        "id": 497,
        "insight": "Users felt the added value of Noxtua's large archive/data volume did not justify the cost or effort of keeping it versus switching to the competitor.",
        "mentions": 1,
        "delta": 1,
        "created": "2026-08-10",
        "segment": "Unknown"
      },
      {
        "id": 498,
        "insight": "Trial users saw an advantage for the competitor on deep, thorough research tasks (“dicke Fälle” / heavy cases) requiring extensive investigation.",
        "mentions": 1,
        "delta": 1,
        "created": "2026-08-10",
        "segment": "Unknown"
      },
      {
        "id": 499,
        "insight": "Procurement declined budget to run two parallel legal AI tools; the decision was purely financial rather than a directive from the Swedish parent company.",
        "mentions": 1,
        "delta": 1,
        "created": "2026-08-10",
        "segment": "Unknown"
      },
      {
        "id": 500,
        "insight": "Customer indicated a target price point of around €200 per user/month and requested volume-discount tiers starting at 25, 50, and 100 licenses.",
        "mentions": 1,
        "delta": 1,
        "created": "2026-08-10",
        "segment": "Unknown"
      },
      {
        "id": 501,
        "insight": "To ease the transition to the competitor, the customer asked to keep a minimal footprint of 4–6 Noxtua licenses (including one for HR for works-council parity), while navigating an InfoSec/LECS review for early activation.",
        "mentions": 1,
        "delta": 1,
        "created": "2026-08-10",
        "segment": "Unknown"
      }
    ],
